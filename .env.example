# =============================================================================
# bfsi-rbi environment configuration
# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# MiniMax (LLM provider, OpenAI-compatible)
# Get these from https://platform.minimax.io
# -----------------------------------------------------------------------------
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_API_KEY=sk-PLACEHOLDER-replace-with-your-real-key
MINIMAX_MODEL=MiniMax-M3

# -----------------------------------------------------------------------------
# Elastic Cloud (Serverless Elasticsearch + Kibana)
# Create a free trial at https://cloud.elastic.co/registration
# After creating the deployment, generate an API key under Stack Management
# -----------------------------------------------------------------------------
ELASTIC_URL=https://your-deployment.es.us-east-1.aws.elastic.cloud
ELASTIC_API_KEY=PLACEHOLDER_replace_with_encoded_api_key
ELASTIC_MCP_URL=https://your-deployment.es.us-east-1.aws.elastic.cloud/api/agent_builder/mcp

# -----------------------------------------------------------------------------
# Pipeline knobs (optional — defaults shown)
# -----------------------------------------------------------------------------
# Fetch
RBI_FETCH_MAX_DOCS=120
# Ingest
BFSI_INDEX_NAME=rbi-circulars
BFSI_CHUNK_SIZE=1500
BFSI_CHUNK_OVERLAP=200
# Eval
BFSI_EVAL_CONCURRENCY=5
BFSI_EVAL_LIMIT=40
# Tooling
BFSI_LOG_LEVEL=INFO
BFSI_HTTP_TIMEOUT=30
