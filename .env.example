# =============================================================================
# docendo environment configuration
# Copy this file to .env and fill in real values.
# .env is in .gitignore - never commit secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Chat model (LiteLLM, OpenAI-compatible)
# Any OpenAI-compatible endpoint works.
# -----------------------------------------------------------------------------
CHAT_URL=https://api.minimax.io/v1
CHAT_KEY=sk-PLACEHOLDER-replace-with-your-real-key
CHAT_MODEL=MiniMax-M3
CHAT_TIMEOUT=60

# -----------------------------------------------------------------------------
# Embeddings (Qwen3-Embedding-8B via OpenAI-compatible endpoint)
# Set VECTOR_BASE to any /v1/embeddings route serving Qwen3-Embedding-8B
# (vLLM, Ollama, DashScope, or hosted Qwen inference).
# VECTOR_MODEL and TOKENIZER_MODEL must match.
# -----------------------------------------------------------------------------
VECTOR_PROVIDER=openai_compatible
VECTOR_MODEL=Qwen/Qwen3-Embedding-8B
VECTOR_DIMS=4096
VECTOR_KEY=replace-with-your-embedding-key
VECTOR_BASE=https://your-qwen-endpoint.example.com
VECTOR_BATCH=64
TOKENIZER_MODEL=Qwen/Qwen3-Embedding-8B
TOKENIZER_ALLOW_MISMATCH=0

# -----------------------------------------------------------------------------
# Chunking (gigatoken tokens)
# -----------------------------------------------------------------------------
CHUNK_SIZE=384
CHUNK_OVERLAP=64
CHUNK_MAX_CHARS=400

# -----------------------------------------------------------------------------
# Retrieval
# -----------------------------------------------------------------------------
STORE_PATH=data/processed/docendo.sqlite3
RRF_K=60

# -----------------------------------------------------------------------------
# Fetch and eval
# -----------------------------------------------------------------------------
FETCH_MAX_DOCS=120
EVAL_CONCURRENCY=5
EVAL_LIMIT=40

# -----------------------------------------------------------------------------
# Tooling
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
HTTP_TIMEOUT=30

# -----------------------------------------------------------------------------
# CI hooks (do not delete)
# -----------------------------------------------------------------------------
# BFSI_RUN_PERF=1 to enable perf benchmarks (see tests/perf/)
# BFSI_RUN_INTEGRATION=1 to enable integration tests against live services
